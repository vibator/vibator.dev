---
/** The page shell: the fonts, the head tags, the theme script, the header and the footer. */
import { Font } from "astro:assets";
import "../styles/site.css";
import SiteFooter from "../components/site-footer.astro";
import SiteHeader from "../components/site-header.astro";
import { link } from "../lib/url.ts";

/** Props of the shell. */
interface Props {
  /** The page's full title, as the browser tab shows it. */
  title: string;
  /** The page's description. */
  description: string;
  /** The section the page belongs to, marked as current in the header. */
  current?: "docs";
  /** The site path of the page that stands for this one, such as the latest release's doc. */
  canonicalPath?: string;
}

const { title, description, current, canonicalPath } = Astro.props;
const canonical = new URL(
  canonicalPath === undefined ? Astro.url.pathname : link(canonicalPath),
  Astro.site,
).href;
/** The social preview image, as an absolute address. */
const image = new URL(link("og.png"), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-overpass" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <script is:inline>
      // Applies the stored theme before the first paint. Storage can be blocked.
      (() => {
        let scheme = "system";
        try {
          scheme = localStorage.getItem("vibator.color-scheme") || "system";
        } catch {}
        const dark =
          scheme === "dark" ||
          (scheme !== "light" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.scheme = scheme;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="vibator" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta property="og:image:alt" content="The vibator logo, the name vibator, and the line: Project rules instead of check scripts." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={link("favicon.svg")} />
    <link rel="sitemap" href={link("sitemap-index.xml")} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {
      Astro.slots.has("header-search") ? (
        <SiteHeader {...(current === undefined ? {} : { current })}>
          <slot name="header-search" slot="search" />
          <slot name="header-menu" slot="menu" />
        </SiteHeader>
      ) : (
        <SiteHeader {...(current === undefined ? {} : { current })} />
      )
    }
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
