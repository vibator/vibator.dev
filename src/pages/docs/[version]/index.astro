---
/** The home of a version's docs, such as `docs/next/`: it opens the version's first guide page. */
import Redirect from "../../../components/redirect.astro";
import { allVersions } from "../../../lib/docs-content.ts";
import { firstDocSlug } from "../../../lib/docs-nav.ts";
import type { DocVersion } from "../../../lib/versions.ts";

/**
 * Lists one home per version that `docs/` does not show.
 *
 * @returns The paths and their versions.
 */
export function getStaticPaths() {
  return allVersions()
    .filter((version) => !version.latest)
    .map((version) => ({
      params: { version: version.id },
      props: { version },
    }));
}

const { version } = Astro.props as { version: DocVersion };
---

<Redirect to={`/${version.path}${firstDocSlug}/`} />
